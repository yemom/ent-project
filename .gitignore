# Dependencies
node_modules/

# Next.js / frontend build output
.next/
.next-build/
.next-e2e/
# `.next-verify` is the output directory used when verifying a build against a
# running backend; it is build output like any other and must not be committed.
.next-verify/
# `.next-dev` is the default dist dir for `npm run dev` (see frontend/scripts/dev.mjs).
# It must be ignored for the same reason as the others, and more sharply: it is the
# ONE build directory a long-running process rewrites continuously. While its files
# were tracked, every `git status`/`git add` opened read handles on exactly the files
# the dev server was rewriting, and on Windows that collision surfaced as
#   [Error: UNKNOWN: unknown error, open '.next-dev/react-loadable-manifest.json']
# repeating forever, because the conflict was structural rather than transient.
.next-dev/
.vercel/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Spring Boot / Java build output
target/
*.class
*.jar
*.war
.m2/

# Secrets and local environment files
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local

# Logs
*.log
logs/

# IDE / OS files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Database files
*.db
*.sqlite
*.h2.db

# Coverage and test artifacts
coverage/
jacoco.csv
test-results/
playwright-report/
blob-report/
.playwright/

# Java language server output. Must not be target/classes: Maven and the
# IDE compiling into the same directory corrupts each other's class files.
target/ide-classes/

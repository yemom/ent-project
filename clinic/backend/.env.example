# Example Super Admin credentials (do NOT commit real secrets)
# The legacy ADMIN_NAME / ADMIN_EMAIL / ADMIN_PASSWORD names are still honoured.
SUPER_ADMIN_NAME=Your Admin Name
SUPER_ADMIN_EMAIL=your-admin@example.com
SUPER_ADMIN_PASSWORD=YourSecurePassword123!

# Database
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_pass
POSTGRES_DB=clinic_db
# Keep this equal to POSTGRES_PASSWORD if you choose a different local DB value.
SPRING_DATASOURCE_PASSWORD=clinic_pass

# Spring
SPRING_PROFILES_ACTIVE=prod

# APP_JWT_SECRET must be at least 64 bytes: HS512 rejects shorter keys, and the
# application now refuses to start rather than failing every sign-in with a 500.
# Generate one with:  openssl rand -base64 64
APP_JWT_SECRET=replace-with-at-least-64-bytes-for-hs512-signing
APP_JWT_ISSUER=clinic

# AI assistant. Local Ollama keeps the graduation demo's clinical context on-host.
# Forecast facts are still available from the database when the provider is off.
AI_ENABLED=true
AI_PROVIDER=local-ollama
AI_API_URL=http://localhost:11434
AI_MODEL=llama3.2
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=700
# Keep false unless the deployment has approved sending identifiable clinical text
# to the configured provider.
AI_ALLOW_IDENTIFIABLE_DATA=false
# Optional comma-separated host allow-list, for example api.openai.com
AI_ALLOWED_HOSTS=localhost

# Example Super Admin credentials (do NOT commit real secrets)
# The legacy ADMIN_NAME / ADMIN_EMAIL / ADMIN_PASSWORD names are still honoured.
SUPER_ADMIN_NAME=Your Admin Name
SUPER_ADMIN_EMAIL=your-admin@example.com
SUPER_ADMIN_PASSWORD=YourSecurePassword123!

# Database
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_pass
POSTGRES_DB=clinic_db

# Spring
SPRING_PROFILES_ACTIVE=prod

# APP_JWT_SECRET must be at least 64 bytes: HS512 rejects shorter keys, and the
# application now refuses to start rather than failing every sign-in with a 500.
# Generate one with:  openssl rand -base64 64
APP_JWT_SECRET=replace-with-at-least-64-bytes-for-hs512-signing
APP_JWT_ISSUER=clinic